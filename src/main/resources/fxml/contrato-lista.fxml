<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/19"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.proyectobdmotos.controller.ContratoController"
      stylesheets="@/styles/contrato-lista.css"
      spacing="10"
      styleClass="root-vbox">

    <TableView fx:id="tablaContratos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="ID" fx:id="colId" />
            <TableColumn text="Cliente" fx:id="colCliente" />
            <TableColumn text="Moto" fx:id="colMoto" />
            <TableColumn text="Fecha Inicio" fx:id="colFechaInicio" />
            <TableColumn text="Fecha Fin" fx:id="colFechaFin" />
            <TableColumn text="Estado" fx:id="colEstado" />
            <TableColumn text="Importe" fx:id="colImporte" />
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="15" styleClass="botonera">
        <Button text="Finalizar" onAction="#onFinalizarContrato" styleClass="btn-finalizar" />
        <Button text="Eliminar" onAction="#onEliminarContrato" styleClass="btn-eliminar" />
        <Button text="Actualizar" onAction="#onActualizarLista" styleClass="btn-accion" />
    </HBox>
</VBox>