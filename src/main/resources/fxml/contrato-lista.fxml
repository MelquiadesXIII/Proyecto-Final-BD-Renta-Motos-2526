<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.proyectobdmotos.utils.AutoSizeTableView?>

<StackPane xmlns="http://javafx.com/javafx/19"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.proyectobdmotos.controller.ContratoController"
           fx:id="rootPane"
           stylesheets="@/styles/listas-comunes.css,@/styles/tablas-estilos.css">

    <VBox spacing="10" styleClass="root-vbox">
        <Label text="Tabla de Contratos" styleClass="table-title" />
        <AutoSizeTableView fx:id="tablaContratos" VBox.vgrow="ALWAYS" editable="false">
            <columns>
                <TableColumn text="ID" fx:id="colId"/>
                <TableColumn text="CI" fx:id="colCiCliente"/>
                <TableColumn text="Nombre Cliente" fx:id="colNombreCliente"/>
                <TableColumn text="Matrícula" fx:id="colMatriculaMoto"/>
                <TableColumn text="Marca Moto" fx:id="colMarcaMoto"/>
                <TableColumn text="Modelo Moto" fx:id="colModeloMoto"/>
                <TableColumn text="Km Salida" fx:id="colKmSalida"/>
                <TableColumn text="Km Llegada" fx:id="colKmLlegada"/>
                <TableColumn text="Fecha Inicio" fx:id="colFechaInicio"/>
                <TableColumn text="Fecha Fin" fx:id="colFechaFin"/>
                <TableColumn text="Estado" fx:id="colEstado"/>
                <TableColumn text="Importe" fx:id="colImporte"/>
            </columns>
        </AutoSizeTableView>

        <HBox alignment="CENTER" spacing="15" styleClass="botonera">
            <Button text="Nuevo Contrato" onAction="#onCrearContrato" styleClass="btn-accion" />
            <Button text="Finalizar" onAction="#onFinalizarContrato" styleClass="btn-finalizar" />
            <Button text="Eliminar" onAction="#onEliminarContrato" styleClass="btn-eliminar" />
            <Button text="Actualizar" onAction="#onActualizarLista" styleClass="btn-accion" />
        </HBox>
    </VBox>
</StackPane>
