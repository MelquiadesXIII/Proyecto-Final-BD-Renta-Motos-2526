<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/19"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.proyectobdmotos.controller.ContratoController"
           fx:id="rootPane"
           stylesheets="@/styles/contrato-lista.css,@/styles/tablas-estilos.css">

    <VBox spacing="10" styleClass="root-vbox">
        <Label text="Tabla de Contratos" styleClass="table-title" />
        <TableView fx:id="tablaContratos" VBox.vgrow="ALWAYS" editable="false">
            <columns>
                <TableColumn text="ID" fx:id="colId" resizable="false" />
                <TableColumn text="CI" fx:id="colCiCliente" resizable="false"/>
                <TableColumn text="Nombre Cliente" fx:id="colNombreCliente" resizable="false"/>
                <TableColumn text="Matrícula" fx:id="colMatriculaMoto" resizable="false"/>
                <TableColumn text="Marca Moto" fx:id="colMarcaMoto" resizable="false"/>
                <TableColumn text="Modelo Moto" fx:id="colModeloMoto" resizable="false"/>
                <TableColumn text="Km Salida" fx:id="colKmSalida" resizable="false"/>
                <TableColumn text="Km Llegada" fx:id="colKmLlegada" resizable="false"/>
                <TableColumn text="Fecha Inicio" fx:id="colFechaInicio" resizable="false"/>
                <TableColumn text="Fecha Fin" fx:id="colFechaFin" resizable="false"/>
                <TableColumn text="Estado" fx:id="colEstado" resizable="false"/>
                <TableColumn text="Importe" fx:id="colImporte" resizable="false"/>
            </columns>
        </TableView>

        <HBox alignment="CENTER" spacing="15" styleClass="botonera">
            <Button text="Nuevo Contrato" onAction="#onCrearContrato" styleClass="btn-accion" />
            <Button text="Finalizar" onAction="#onFinalizarContrato" styleClass="btn-finalizar" />
            <Button text="Eliminar" onAction="#onEliminarContrato" styleClass="btn-eliminar" />
            <Button text="Actualizar" onAction="#onActualizarLista" styleClass="btn-accion" />
        </HBox>
    </VBox>
</StackPane>