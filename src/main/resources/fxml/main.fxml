<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/19"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.proyectobdmotos.controller.MainController"
            stylesheets="@/styles/app.css">

    <!-- Barra superior -->
    <top>
        <HBox styleClass="top-bar" spacing="20" alignment="CENTER_LEFT">
            <Label text="Renta Motos - Administración" styleClass="top-title" />
        </HBox>
    </top>

    <!-- Barra lateral izquierda -->
    <left>
        <VBox styleClass="sidebar" spacing="10" fillWidth="true">
            <Button text="Nuevo Contrato" onAction="#onShowNuevoContrato" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button text="Clientes" onAction="#onShowClientes" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button text="Contratos" onAction="#onShowContratos" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button text="Inventario" onAction="#onShowInventario" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button text="Reportes" onAction="#onShowReportes" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button text="Ayuda" onAction="#onShowAyuda" styleClass="sidebar-button" maxWidth="Infinity" />
            <Button text="← Atrás" onAction="#onGoBack" styleClass="sidebar-button" maxWidth="Infinity" />
        </VBox>
    </left>

    <!-- Contenido central dinámico -->
    <center>
        <StackPane fx:id="contentContainer" styleClass="content-area" />
    </center>
</BorderPane>