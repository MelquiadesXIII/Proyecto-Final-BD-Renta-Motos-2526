<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/19"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.proyectobdmotos.controller.ContratoUsuarioFormController"
           stylesheets="@/styles/contrato-form.css"
           alignment="CENTER">

    <GridPane hgap="0" vgap="0" alignment="CENTER">
        <columnConstraints>
            <ColumnConstraints percentWidth="20" />
            <ColumnConstraints percentWidth="60" />
            <ColumnConstraints percentWidth="20" />
        </columnConstraints>

        <VBox alignment="CENTER" spacing="15" styleClass="form-box"
              GridPane.columnIndex="1">
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="transparent-scroll">
                <VBox alignment="CENTER" spacing="20" styleClass="transparent-box">
                    <Label text="Nuevo Contrato" styleClass="form-title"/>

                    <!-- Fechas -->
                    <Label text="Fechas del Contrato" styleClass="section-title"/>
                    <GridPane hgap="15" vgap="15" alignment="CENTER">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="30" halignment="RIGHT"/>
                            <ColumnConstraints percentWidth="70" halignment="LEFT"/>
                        </columnConstraints>
                        <Label text="Fecha Inicio*" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <DatePicker fx:id="dateInicio" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="form-field"/>
                        <Label text="Fecha Fin*" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <DatePicker fx:id="dateFin" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="form-field"/>
                    </GridPane>

                    <!-- Moto -->
                    <Label text="Moto Disponible*" styleClass="section-title"/>
                    <ComboBox fx:id="comboMoto" promptText="Primero seleccione las fechas" styleClass="form-field" maxWidth="Infinity"/>
                    <Label fx:id="labelSinMotos" text="No hay motos disponibles en las fechas seleccionadas"
                           styleClass="error-label" visible="false" managed="false" />

                    <Separator/>

                    <!-- Forma de pago y precio -->
                    <Label text="Forma de Pago*" styleClass="section-title"/>
                    <ComboBox fx:id="comboPago" styleClass="form-field" maxWidth="Infinity"/>

                    <Label fx:id="labelPrecio" text="0.00 CUP" styleClass="precio-label"/>

                    <HBox alignment="CENTER" spacing="25">
                        <Button text="Guardar" onAction="#onGuardar" styleClass="btn-guardar"/>
                        <Button text="Cancelar" onAction="#onCancelar" styleClass="btn-cancelar"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </GridPane>
</StackPane>