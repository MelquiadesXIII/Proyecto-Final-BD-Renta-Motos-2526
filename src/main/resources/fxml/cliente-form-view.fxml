<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/19"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.proyectobdmotos.controller.ClienteFormController"
           stylesheets="@/styles/cliente-form.css"
           alignment="CENTER">

    <GridPane hgap="0" vgap="0" alignment="CENTER">
        <columnConstraints>
            <ColumnConstraints percentWidth="20" />
            <ColumnConstraints percentWidth="60" />
            <ColumnConstraints percentWidth="20" />
        </columnConstraints>

        <VBox alignment="CENTER_RIGHT" spacing="15" styleClass="form-box"
              GridPane.columnIndex="1">
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="transparent-scroll">
                <VBox alignment="CENTER" spacing="15" styleClass="form-box">
                    <Label text="Nuevo Cliente" styleClass="form-title"/>

                    <!-- Datos de la cuenta -->
                    <Label text="Datos de la cuenta" styleClass="section-title"/>
                    <GridPane hgap="10" vgap="15" alignment="CENTER">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="30"/>
                            <ColumnConstraints percentWidth="70"/>
                        </columnConstraints>

                        <Label text="Usuario*" labelFor="$campoNombreUsuario"
                               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoNombreUsuario" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Contraseña*" labelFor="$campoPassword"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <PasswordField fx:id="campoPassword" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <CheckBox fx:id="checkVerPassword" text="Ver contraseña"
                                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <TextField fx:id="campoPasswordVisible" visible="false" editable="false"
                                   GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Gmail*" labelFor="$campoGmail"
                               GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoGmail" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <CheckBox fx:id="checkEsAdmin" text="¿Es administrador?"
                                  GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                    </GridPane>

                    <Separator/>

                    <!-- Datos del cliente -->
                    <Label text="Datos del cliente" styleClass="section-title"/>
                    <GridPane fx:id="gridCliente" hgap="10" vgap="15" alignment="CENTER">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="30"/>
                            <ColumnConstraints percentWidth="70"/>
                        </columnConstraints>

                        <Label text="CI*" labelFor="$campoCI"
                               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoCI" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Nombre*" labelFor="$campoNombre"
                               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoNombre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Primer Apellido*" labelFor="$campoPrimerApellido"
                               GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoPrimerApellido" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Segundo Apellido" labelFor="$campoSegundoApellido"
                               GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoSegundoApellido" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Edad*" labelFor="$campoEdad"
                               GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoEdad" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Sexo*" labelFor="$comboSexo"
                               GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="comboSexo" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <Label text="Teléfono*" labelFor="$campoTelefono"
                               GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoTelefono" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                        <Label text="Municipio*" labelFor="$comboMunicipio"
                               GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="comboMunicipio" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                    </GridPane>

                    <HBox alignment="CENTER" spacing="20">
                        <Button text="Guardar" onAction="#onGuardar" styleClass="btn-guardar"/>
                        <Button text="Cancelar" onAction="#onCancelar" styleClass="btn-cancelar"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </GridPane>
</StackPane>