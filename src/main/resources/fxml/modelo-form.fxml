<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/19"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.proyectobdmotos.controller.ModeloFormController"
           stylesheets="@/styles/modelo-form.css"
           alignment="CENTER">

    <!-- GridPane centrador: columna central = 50% del ancho -->
    <GridPane hgap="0" vgap="0" alignment="CENTER">
        <columnConstraints>
            <ColumnConstraints percentWidth="25" />
            <ColumnConstraints percentWidth="50" />
            <ColumnConstraints percentWidth="25" />
        </columnConstraints>

        <!-- Panel del formulario -->
        <VBox alignment="CENTER" spacing="15" styleClass="form-box"
              GridPane.columnIndex="1">
            <Label text="Nuevo Modelo" styleClass="form-title" />

            <GridPane hgap="10" vgap="15" alignment="CENTER">
                <columnConstraints>
                    <ColumnConstraints percentWidth="30" />
                    <ColumnConstraints percentWidth="70" />
                </columnConstraints>

                <Label text="Nombre*" styleClass="form-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="campoNombreModelo" promptText="Nombre del modelo" styleClass="form-field"
                           GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />

                <Label text="Marca*" styleClass="form-label"
                       GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <ComboBox fx:id="comboMarca" promptText="Seleccionar marca" styleClass="form-field"
                          GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />
            </GridPane>

            <HBox alignment="CENTER" spacing="10">
                <Button text="Crear nueva marca" onAction="#onCrearMarca" styleClass="btn-link" />
            </HBox>

            <HBox alignment="CENTER" spacing="20">
                <Button text="Guardar" onAction="#onGuardar" styleClass="btn-guardar" />
                <Button text="Cancelar" onAction="#onCancelar" styleClass="btn-cancelar" />
            </HBox>
        </VBox>
    </GridPane>
</StackPane>