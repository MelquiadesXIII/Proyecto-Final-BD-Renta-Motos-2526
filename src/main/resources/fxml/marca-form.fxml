<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/19"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.proyectobdmotos.controller.MarcaFormController"
           stylesheets="@/styles/marca-form.css"
           alignment="CENTER">

    <GridPane hgap="0" vgap="0" alignment="CENTER">
        <columnConstraints>
            <ColumnConstraints percentWidth="25" />
            <ColumnConstraints percentWidth="50" />
            <ColumnConstraints percentWidth="25" />
        </columnConstraints>

        <VBox alignment="CENTER" spacing="15" styleClass="form-box"
              GridPane.columnIndex="1">
            <Label text="Nueva Marca" styleClass="form-title" />

            <GridPane hgap="10" vgap="15" alignment="CENTER">
                <columnConstraints>
                    <ColumnConstraints percentWidth="30" />
                    <ColumnConstraints percentWidth="70" />
                </columnConstraints>

                <Label text="Nombre*" labelFor="$campoNombreMarca"
                       styleClass="form-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="campoNombreMarca" promptText="Nombre de la marca" styleClass="form-field"
                           GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />
            </GridPane>

            <HBox alignment="CENTER" spacing="20">
                <Button text="Guardar" onAction="#onGuardar" styleClass="btn-guardar" />
                <Button text="Cancelar" onAction="#onCancelar" styleClass="btn-cancelar" />
            </HBox>
        </VBox>
    </GridPane>
</StackPane>