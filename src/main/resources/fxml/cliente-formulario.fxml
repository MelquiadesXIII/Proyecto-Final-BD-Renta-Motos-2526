<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/19"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.proyectobdmotos.controller.ClienteFormController"
    stylesheets="@/styles/cliente-form.css">

    <ImageView fx:id="fondoLogin" fitWidth="1920" fitHeight="1080" preserveRatio="false"
        pickOnBounds="true">
        <image>
            <Image url="@../Utiles/registrar-usuario-admin.jpg" />
        </image>
    </ImageView>
    
    <VBox alignment="CENTER" maxWidth="600" spacing="15"
          styleClass="form-box">

        <Label text="Nuevo Cliente" styleClass="form-title" />

        <!-- ============================================================ -->
        <!-- SECCIÓN 1: DATOS DEL USUARIO                                  -->
        <!-- ============================================================ -->
        <Label text="Datos de la cuenta" styleClass="section-title" />

        <GridPane hgap="10" vgap="15" alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints percentWidth="30" />
                <ColumnConstraints percentWidth="70" />
            </columnConstraints>

            <!-- Usuario -->
            <Label text="Usuario*" styleClass="form-label"
                   GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="campoNombreUsuario" promptText="Nombre de usuario" styleClass="form-field"
                       GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />

            <!-- Contraseña -->
            <Label text="Contraseña*" styleClass="form-label"
                   GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <PasswordField fx:id="campoPassword" promptText="Contraseña" styleClass="form-field"
                           GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />

            <!-- Gmail -->
            <Label text="Gmail*" styleClass="form-label"
                   GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <TextField fx:id="campoGmail" promptText="correo@ejemplo.com" styleClass="form-field"
                       GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />

            <!-- CheckBox: ¿Es administrador? -->
            <CheckBox fx:id="checkEsAdmin" text="¿Es administrador?" styleClass="admin-check"
                      GridPane.rowIndex="3" GridPane.columnIndex="1" />
        </GridPane>

        <!-- Separador visual -->
        <Separator styleClass="separator" />

        <!-- ============================================================ -->
        <!-- SECCIÓN 2: DATOS DEL CLIENTE                                  -->
        <!-- ============================================================ -->
        <Label text="Datos del cliente" styleClass="section-title" />

        <GridPane hgap="10" vgap="15" alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints percentWidth="30" />
                <ColumnConstraints percentWidth="70" />
            </columnConstraints>

            <!-- CI -->
            <Label text="CI (11 dígitos)*" styleClass="form-label"
                   GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="campoCI" promptText="Ej: 99123112345" styleClass="form-field"
                       GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />

            <!-- Nombre -->
            <Label text="Nombre*" styleClass="form-label"
                   GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <TextField fx:id="campoNombre" promptText="Nombre del cliente" styleClass="form-field"
                       GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />

            <!-- Primer Apellido -->
            <Label text="Primer Apellido*" styleClass="form-label"
                   GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <TextField fx:id="campoPrimerApellido" promptText="Primer apellido" styleClass="form-field"
                       GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />

            <!-- Segundo Apellido -->
            <Label text="Segundo Apellido" styleClass="form-label"
                   GridPane.rowIndex="3" GridPane.columnIndex="0" />
            <TextField fx:id="campoSegundoApellido" promptText="Segundo apellido (opcional)" styleClass="form-field"
                       GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />

            <!-- Edad -->
            <Label text="Edad (18-99)*" styleClass="form-label"
                   GridPane.rowIndex="4" GridPane.columnIndex="0" />
            <TextField fx:id="campoEdad" promptText="Edad" styleClass="form-field"
                       GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />

            <!-- Sexo -->
            <Label text="Sexo*" styleClass="form-label"
                   GridPane.rowIndex="5" GridPane.columnIndex="0" />
            <ComboBox fx:id="comboSexo" promptText="Seleccionar" styleClass="form-field"
                      GridPane.rowIndex="5" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />

            <!-- Teléfono -->
            <Label text="Teléfono*" styleClass="form-label"
                   GridPane.rowIndex="6" GridPane.columnIndex="0" />
            <TextField fx:id="campoTelefono" promptText="8 dígitos, empieza con 5 o 6" styleClass="form-field"
                       GridPane.rowIndex="6" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />

            <!-- Municipio -->
            <Label text="Municipio*" styleClass="form-label"
                   GridPane.rowIndex="7" GridPane.columnIndex="0" />
            <ComboBox fx:id="comboMunicipio" promptText="Seleccionar" styleClass="form-field"
                      GridPane.rowIndex="7" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />
        </GridPane>

        <!-- Botones -->
        <HBox alignment="CENTER" spacing="20">
            <Button text="Guardar" onAction="#onGuardar" styleClass="btn-guardar" />
            <Button text="Cancelar" onAction="#onCancelar" styleClass="btn-cancelar" />
        </HBox>
    </VBox>
</StackPane>