<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.proyectobdmotos.utils.AutoSizeTableView?>

<StackPane xmlns="http://javafx.com/javafx/19"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.proyectobdmotos.controller.InventarioController"
           fx:id="rootPane"
           stylesheets="@/styles/listas-comunes.css,@/styles/tablas-estilos.css">

    <VBox spacing="10" styleClass="root-vbox">
        <Label text="Inventario" styleClass="table-title" />
        <AutoSizeTableView fx:id="tablaInventario" VBox.vgrow="ALWAYS" editable="false">
            <columns>
                <TableColumn text="Matrícula" fx:id="colMatriculaInv"/>
                <TableColumn text="Marca" fx:id="colMarcaInv"/>
                <TableColumn text="Situación" fx:id="colSituacionInv"/>
                <TableColumn text="Fin Contrato" fx:id="colFechaFinInv"/>
            </columns>
        </AutoSizeTableView>
    </VBox>
</StackPane>
