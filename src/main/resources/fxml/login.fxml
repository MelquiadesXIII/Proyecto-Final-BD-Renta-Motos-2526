<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>

<StackPane xmlns="http://javafx.com/javafx/19"
   xmlns:fx="http://javafx.com/fxml/1"
   fx:controller="org.proyectobdmotos.controller.LoginController"
   stylesheets="@/styles/login.css">

   <!-- Imagen de fondo -->
   <ImageView fx:id="fondoLogin" fitWidth="1920" fitHeight="1080" preserveRatio="false"
      pickOnBounds="true">
      <image>
         <Image url="@../Utiles/moto-login.jpg" />
      </image>
   </ImageView>

   <!-- Contenedor del formulario -->
   <VBox alignment="CENTER" maxWidth="500" spacing="15"
      styleClass="login-box">

      <Label text="Iniciar sesión" styleClass="login-title" />

      <GridPane hgap="10" vgap="15" alignment="CENTER">
         <columnConstraints>
            <ColumnConstraints percentWidth="30" />
            <ColumnConstraints percentWidth="70" />
         </columnConstraints>
         <Label text="Usuario" styleClass="login-label"
            GridPane.rowIndex="0" GridPane.columnIndex="0" />
         <TextField fx:id="campoUsuario" promptText="Usuario" styleClass="login-text-field"
            GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />

         <Label text="Contraseña" styleClass="login-label"
            GridPane.rowIndex="1" GridPane.columnIndex="0" />
         <PasswordField fx:id="campoContrasena" promptText="Contraseña"
            styleClass="login-text-field"
            GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />
      </GridPane>

      <Button text="Iniciar sesión"
            onAction="#onIngresar"
            styleClass="login-button" />

      <Hyperlink
         onAction="#goToRegister"
         styleClass="login-link"
         text="¿No tienes cuenta? Crear usuario" />

      <Hyperlink
         onAction="#goToTerms"
         styleClass="login-link"
         text="Condiciones y Servicios" />

      <Hyperlink
         onAction="#goToCredits"
         styleClass="login-link"
         text="Acerca de" />

   </VBox>
</StackPane>
