<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/19"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.proyectobdmotos.controller.MotoFormController"
           stylesheets="@/styles/moto-form.css">

    <VBox alignment="CENTER" maxWidth="500" spacing="15"
          styleClass="form-box">

        <Label text="Nueva Moto" styleClass="form-title" />

        <GridPane hgap="10" vgap="15" alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints percentWidth="30" />
                <ColumnConstraints percentWidth="60" />
                <ColumnConstraints percentWidth="10" />
            </columnConstraints>

            <!-- Matrícula -->
            <Label text="Matrícula*" styleClass="form-label"
                   GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="campoMatricula" promptText="Ej: ABC123" styleClass="form-field"
                       GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.hgrow="ALWAYS" />

            <!-- Marca (nuevo) -->
            <Label text="Marca*" styleClass="form-label"
                   GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <ComboBox fx:id="comboMarca" promptText="Seleccionar marca" styleClass="form-field"
                      GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />

            <!-- Botón "Crear nueva marca" (opcional, lo dejamos) -->
            <Button text="Nueva marca" onAction="#onCrearMarca" styleClass="btn-link"
                    GridPane.rowIndex="1" GridPane.columnIndex="2" />

            <!-- Modelo -->
            <Label text="Modelo*" styleClass="form-label"
                   GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <ComboBox fx:id="comboModelo" promptText="Primero elige una marca" styleClass="form-field"
                      GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" />

            <!-- Botón "Crear nuevo modelo" -->
            <Button text="Nuevo modelo" onAction="#onCrearModelo" styleClass="btn-link"
                    GridPane.rowIndex="2" GridPane.columnIndex="2" />

            <!-- Color -->
            <Label text="Color*" styleClass="form-label"
                   GridPane.rowIndex="3" GridPane.columnIndex="0" />
            <ComboBox fx:id="comboColor" promptText="Seleccionar color" styleClass="form-field"
                      GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.hgrow="ALWAYS" />

            <!-- Kilómetros -->
            <Label text="Km recorridos*" styleClass="form-label"
                   GridPane.rowIndex="4" GridPane.columnIndex="0" />
            <TextField fx:id="campoKilometros" promptText="0" styleClass="form-field"
                       GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.hgrow="ALWAYS" />
        </GridPane>

        <!-- Botones principales -->
        <HBox alignment="CENTER" spacing="20">
            <Button text="Guardar" onAction="#onGuardar" styleClass="btn-guardar" />
            <Button text="Cancelar" onAction="#onCancelar" styleClass="btn-cancelar" />
        </HBox>
    </VBox>
</StackPane>