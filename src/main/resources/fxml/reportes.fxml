<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.proyectobdmotos.utils.AutoSizeTableView?>

<StackPane xmlns="http://javafx.com/javafx/19"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.proyectobdmotos.controller.ReportesController"
           fx:id="rootPane"
           stylesheets="@/styles/listas-comunes.css,@/styles/tablas-estilos.css">

    <VBox spacing="10" styleClass="root-vbox">
        <Label text="Reportes" styleClass="table-title" />

        <TabPane VBox.vgrow="ALWAYS">
            <Tab text="Clientes por Municipio" closable="false">
                <VBox spacing="10">
                    <Label text="Muestra la cantidad de alquileres y el total gastado por cada cliente, agrupado por municipio." styleClass="report-description" />
                    <AutoSizeTableView fx:id="tablaClientesMunicipio" editable="false" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="Fecha" fx:id="colFechaCli"/>
                            <TableColumn text="Municipio" fx:id="colMunicipioCli"/>
                            <TableColumn text="Nombre" fx:id="colNombreCli"/>
                            <TableColumn text="CI" fx:id="colCiCli"/>
                            <TableColumn text="Contratos" fx:id="colContratosCli"/>
                            <TableColumn text="Total gastado" fx:id="colTotalCli"/>
                        </columns>
                    </AutoSizeTableView>
                </VBox>
            </Tab>

            <Tab text="Motos" closable="false">
                <VBox spacing="10">
                    <Label text="Listado de todas las motos con su kilometraje actual." styleClass="report-description" />
                    <AutoSizeTableView fx:id="tablaMotos" editable="false" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="Fecha" fx:id="colFechaMoto"/>
                            <TableColumn text="Matrícula" fx:id="colMatriculaMoto"/>
                            <TableColumn text="Marca" fx:id="colMarcaMoto"/>
                            <TableColumn text="Modelo" fx:id="colModeloMoto"/>
                            <TableColumn text="Color" fx:id="colColorMoto"/>
                            <TableColumn text="Km recorridos" fx:id="colKmMoto"/>
                        </columns>
                    </AutoSizeTableView>
                </VBox>
            </Tab>

            <Tab text="Contratos" closable="false">
                <VBox spacing="10">
                    <Label text="Relación completa de contratos: cliente, moto, fechas, forma de pago, prórroga, seguro e importe." styleClass="report-description" />
                    <AutoSizeTableView fx:id="tablaContratos" editable="false" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="Cliente" fx:id="colClienteCont"/>
                            <TableColumn text="Matrícula" fx:id="colMatriculaCont"/>
                            <TableColumn text="Marca" fx:id="colMarcaCont"/>
                            <TableColumn text="Modelo" fx:id="colModeloCont"/>
                            <TableColumn text="Forma de pago" fx:id="colPagoCont"/>
                            <TableColumn text="Inicio" fx:id="colInicioCont"/>
                            <TableColumn text="Fin" fx:id="colFinCont"/>
                            <TableColumn text="Prórroga" fx:id="colProrrogaCont"/>
                            <TableColumn text="Seguro" fx:id="colSeguroCont"/>
                            <TableColumn text="Importe" fx:id="colImporteCont"/>
                        </columns>
                    </AutoSizeTableView>
                </VBox>
            </Tab>

            <Tab text="Situación Motos" closable="false">
                <VBox spacing="10">
                    <Label text="Estado actual de cada moto (disponible, taller, alquilada). Si está alquilada, muestra la fecha fin del contrato." styleClass="report-description" />
                    <AutoSizeTableView fx:id="tablaSituacionMotos" editable="false" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="Fecha" fx:id="colFechaSit"/>
                            <TableColumn text="Matrícula - Marca" fx:id="colMatriculaMarcaSit"/>
                            <TableColumn text="Situación" fx:id="colSituacionSit"/>
                            <TableColumn text="Fecha fin contrato" fx:id="colFechaFinSit"/>
                        </columns>
                    </AutoSizeTableView>
                </VBox>
            </Tab>

            <Tab text="Incumplidores" closable="false">
                <VBox spacing="10">
                    <Label text="Clientes que entregaron la moto después de la fecha pactada, con la fecha límite y la fecha real de entrega." styleClass="report-description" />
                    <AutoSizeTableView fx:id="tablaIncumplidores" editable="false" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="Fecha" fx:id="colFechaInc"/>
                            <TableColumn text="Nombre completo" fx:id="colNombreInc"/>
                            <TableColumn text="Fecha fin" fx:id="colFechaFinInc"/>
                            <TableColumn text="Fecha entrega" fx:id="colFechaEntregaInc"/>
                        </columns>
                    </AutoSizeTableView>
                </VBox>
            </Tab>

            <Tab text="Resumen Marcas/Modelos" closable="false">
                <VBox spacing="10">
                    <Label text="Resumen de ingresos y días alquilados por cada marca y modelo, desglosado por forma de pago." styleClass="report-description" />
                    <AutoSizeTableView fx:id="tablaResumenMarcaModelo" editable="false" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="Fecha" fx:id="colFechaResMM"/>
                            <TableColumn text="Marca" fx:id="colMarcaResMM"/>
                            <TableColumn text="Modelo" fx:id="colModeloResMM"/>
                            <TableColumn text="Cant. Motos" fx:id="colCantMotosResMM"/>
                            <TableColumn text="Días totales" fx:id="colDiasResMM"/>
                            <TableColumn text="Ing. Tarjeta" fx:id="colIngTarjetaResMM"/>
                            <TableColumn text="Ing. Cheque" fx:id="colIngChequeResMM"/>
                            <TableColumn text="Ing. Efectivo" fx:id="colIngEfectivoResMM"/>
                            <TableColumn text="Total Marca" fx:id="colTotalMarcaResMM"/>
                            <TableColumn text="Total General" fx:id="colTotalGeneralResMM"/>
                        </columns>
                    </AutoSizeTableView>
                </VBox>
            </Tab>

            <Tab text="Resumen Municipios" closable="false">
                <VBox spacing="10">
                    <Label text="Resumen de alquileres y días de prórroga por municipio, marca y modelo, con totales." styleClass="report-description" />
                    <AutoSizeTableView fx:id="tablaResumenMunicipio" editable="false" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="Fecha" fx:id="colFechaResMun"/>
                            <TableColumn text="Municipio" fx:id="colMunicipioResMun"/>
                            <TableColumn text="Marca" fx:id="colMarcaResMun"/>
                            <TableColumn text="Modelo" fx:id="colModeloResMun"/>
                            <TableColumn text="Días alquiler" fx:id="colDiasAlqResMun"/>
                            <TableColumn text="Días prórroga" fx:id="colDiasProrrogaResMun"/>
                            <TableColumn text="Valor efectivo" fx:id="colEfectivoResMun"/>
                            <TableColumn text="Valor total" fx:id="colTotalResMun"/>
                        </columns>
                    </AutoSizeTableView>
                </VBox>
            </Tab>

            <Tab text="Ingresos Anuales" closable="false">
                <VBox spacing="10">
                    <Label text="Desglose de ingresos por mes del año en curso." styleClass="report-description" />
                    <AutoSizeTableView fx:id="tablaIngresosAnuales" editable="false" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="Mes" fx:id="colMesAnual"/>
                            <TableColumn text="Ingreso mensual" fx:id="colIngresoMensual"/>
                        </columns>
                    </AutoSizeTableView>
                    <Label fx:id="labelIngresoTotalAnual" styleClass="ingreso-total-label" />
                </VBox>
            </Tab>
        </TabPane>
    </VBox>
</StackPane>
